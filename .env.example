# Copy to .env and edit. .env holds secrets - never commit it.

# Only messages from these groups are stored
# (comma-separated exact group names, case-insensitive, or JIDs ending in @g.us).
# Set this BEFORE linking: WhatsApp sends message history only once, at link time.
WATCH_GROUPS=120363000000000001@g.us, 120363000000000002@g.us

# Delete stored messages and LLM call log entries older than N days (empty/0 = keep forever).
RETENTION_DAYS=720

# Daily email digest (service "digest")
DAILY_AT=20:00
DIGEST_HOURS=24
# DIGEST_GROUPS=...          # defaults to WATCH_GROUPS
SUMMARY_MODEL=dummy           # dummy | ollama | openai (openai needs --allow-real-data, see README)
EMAIL_TO=you@example.com
# Resend without a verified domain: sender must be onboarding@resend.dev and
# EMAIL_TO must be the address your Resend account was created with.
EMAIL_FROM=Szalona Beata <onboarding@resend.dev>
# EMAIL_SUBJECT=WhatsApp digest {date}: {groups}   # placeholders: {date} {hours} {groups}
# EMAIL_TITLE=WhatsApp digest                      # heading at the top of the email
SMTP_PASSWORD=re_xxxxxxxx     # Resend API key
# Defaults (Resend): SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_SECURITY=ssl

# External LLM API for --model openai (OpenAI-compatible; defaults to Groq) - README section 5.
# Real chats are sent only with --allow-real-data; sample_data.py databases work without it.
# LLM_API_KEY=gsk_xxxxxxxx
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=medium  # default low; low|medium|high, or off for models without reasoning
# LLM_RETRY_MINUTES=10         # keep asking an API that doesn't answer for this long; 0 = no retries
# LLM_LOG_DB=off               # default: llm_log.db next to the messages db (prompts + responses, for tuning)
# Senders whose every message is important (e.g. the class teacher): the model never skips them, even a
# photo or a PDF sent without a caption. Comma-separated names (no commas inside a name), spelled as the
# sender appears in the chat transcript (llm_log.db, README 5.5); case doesn't matter.
# IMPORTANT_SENDERS=Anna Nowak, Jan Kowalski

# Text in images (OCR, done by the bridge on your server): photos that pass a fast
# "is there text?" check are read with Tesseract and the text goes into the summary.
# OCR_LANGS=pol+eng            # default; off disables OCR. Other languages need their tesseract-ocr-* package in bridge/Dockerfile

# PDF documents: the bridge reads their text on your server (text layer; scans by OCR with OCR_LANGS).
# PDF_TEXT=on                  # default; off disables it

# Voice messages: with TRANSCRIBE_VOICE=on the bridge sends each voice message (the audio) of the
# watched groups to the LLM API above (Groq by default, LLM_API_KEY) and the transcript goes into
# the summary. Off by default: recordings of other people's voices leave your server - README section 5.
# TRANSCRIBE_VOICE=off
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_LANGUAGE=pl       # ISO 639-1 code; empty = detect the language of each recording
# TRANSCRIBE_BASE_URL=...      # default LLM_BASE_URL; TRANSCRIBE_API_KEY default LLM_API_KEY

# School substitutions (Edupage): a separate section of the digest with the changes for one class
# on the next school day (tomorrow; on Friday/Saturday/Sunday: Monday). Public page, nothing is sent there.
# SUBSTITUTIONS_URL=https://yourschool.edupage.org/substitution/
# SUBSTITUTIONS_CLASS=1C

# New grades from Librus Synergia: one section per child (before the substitutions) with the grades
# added since the last emailed digest. One entry per child: name:login:password (Librus login, e.g.
# 1234567u; the name may be left empty to use the student's first name), entries separated by ';'.
# Unofficial API (librus-synergia) - README "School grades (Librus)". The password may not contain ';'.
# LIBRUS_ACCOUNTS=Ania:1234567u:password;Jaś:7654321u:password
# LIBRUS_STATE=/data/librus_state.json   # default: next to the messages database
# With LIBRUS_ACCOUNTS the digest also lists each child's tests, quizzes and homework from tomorrow on
# (README "Tests and homework (Librus)"); how many days ahead, 0 turns it off:
# LIBRUS_UPCOMING_DAYS=7

# What is due next to an eduSky school (e.g. a language school), one amount for all children, as the last section.
# The parent's login to https://school.edusky.pl/studentpanel/. Unofficial - README "Payments (eduSky)".
# EDUSKY_URL=https://school.edusky.pl
# EDUSKY_LOGIN=login
# EDUSKY_PASSWORD=password
# EDUSKY_NAME=Angielski     # section title (default: Edusky)

# When Edupage, Librus or eduSky doesn't answer, only the failed part is tried again (after 30 s, then
# twice as long each time, up to 2 min) for this many minutes before the digest goes out with the error.
# A refused login or password is not retried. 0 = no retries.
# FETCH_RETRY_MINUTES=10

# Optional
# PAIR_PHONE=48500100200      # better passed once on the command line when linking
# OLLAMA_MODEL=qwen2.5:3b      # needs ~2.5 GB free RAM; qwen2.5:0.5b fits anywhere but makes things up
# SUMMARY_LANGUAGE=Polish
# TZ=Europe/Warsaw
